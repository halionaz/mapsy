# Single ignore file for the whole workspace. Packages do not carry their own —
# duplicated rules drift, and it stops being obvious which file owns what.

node_modules/
dist/
dist-ssr/
coverage/
.vite/
.temp/

# Panda CSS codegen output — regenerate with `pnpm codegen`, never commit or hand-edit
styled-system/

# Supabase project URL and publishable key live here
.env
.env.*
!.env.example

# package-lock.json / yarn.lock are deliberately NOT ignored. npm still writes a
# lockfile even when the preinstall guard rejects it, and a stray one is easier
# to notice in `git status` than hidden.

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?

*.log
*.local
