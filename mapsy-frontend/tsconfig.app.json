{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* 번들러 모드 */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* vite.config.ts의 resolve.alias를 비춘다 — 둘을 같이 고칠 것.
       baseUrl은 없다: TS 6이 폐기했고, paths가 이미 이 파일 기준으로 풀린다. */
    "paths": {
      "styled-system/*": ["./styled-system/*"],
      "@/*": ["./src/*"]
    },

    /* 린팅 */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* `vitest.setup.ts`가 여기 실려 있는 것은 그것이 모든 테스트에서 돌기 때문이다.
     `src` 하나만 두면 그 파일은 어느 프로그램에도 속하지 않아 오타조차 잡히지 않는다. */
  "include": ["src", "vitest.setup.ts"]
}
