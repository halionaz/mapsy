# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API Keys). .env.local is gitignored.
#
# The publishable key is meant to ship to the browser — access is guarded by
# row-level security on every table and storage object, not by keeping this
# value secret.
#
# NEVER put the secret key (sb_secret_...) here. It bypasses RLS entirely, and
# anything in a VITE_-prefixed variable is compiled into the client bundle.
#
# The older `anon` JWT key still works but Supabase deprecates it by the end of
# 2026; new projects should use the publishable key. Both grant the same
# Postgres roles (anon when signed out, authenticated when signed in), so RLS
# behaves identically either way.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
