# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API). .env.local is gitignored.
#
# The anon key is safe to ship to the browser — row-level security is what
# actually protects the data, not the secrecy of this key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
