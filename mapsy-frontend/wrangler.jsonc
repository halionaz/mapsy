// Assets-only Worker — no `main`, so requests are answered at the edge without
// invoking Worker code. See docs/DEPLOY.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Must match the Worker name in the dashboard, or Workers Builds fails.
  "name": "mapsy",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./dist",
    // Hands back index.html for paths with no file, so /items/:id survives a
    // direct open or refresh.
    "not_found_handling": "single-page-application"
  },

  "workers_dev": true,
  // Per-version preview URLs. Public, and they read the production Supabase
  // project — put Cloudflare Access in front or set this to false.
  "preview_urls": true,

  "observability": { "enabled": true }
}
